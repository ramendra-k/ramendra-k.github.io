{% comment %}
  Unified education entry renderer — matches work/experience layout
{% endcomment %}

<style>
  .edu-entry { display: flex; gap: 1rem; padding: 0.75rem 0; }
  .edu-date {
    min-width: 110px;
    max-width: 110px;
    flex-shrink: 0;
    text-align: right;
    padding-top: 0.1rem;
  }
  .edu-date span {
    font-size: 0.8rem;
    font-weight: 500;
    color: #888;
    white-space: nowrap;
  }
  .edu-details { flex: 1; min-width: 0; }
  @media (max-width: 576px) {
    .edu-entry { flex-direction: column; gap: 0.25rem; }
    .edu-date { text-align: left; min-width: auto; max-width: none; }
  }
</style>

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="edu-entry{% unless forloop.last %}" style="border-bottom: 1px solid #f0f0f0;{% endunless %}">
      <div class="edu-date">
        {% capture start_date %}
          {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
        {% endcapture %}
        {% capture end_date %}
          {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
        {% endcapture %}
        {% if start_date != '' %}
          {% assign startDate = start_date | split: '-' | first %}
          {% assign endDate = end_date | split: '-' | first | default: 'Now' %}
          <span>{{ startDate }} – {{ endDate }}</span>
        {% endif %}
      </div>
      <div class="edu-details">
        {% capture study_type %}
          {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
        {% endcapture %}
        {% if entry.url %}
          <h6 class="title font-weight-bold" style="margin-bottom: 0.2rem;">
            <a href="{{ entry.url }}">{{ study_type }}</a>
          </h6>
        {% elsif study_type != '' %}
          <h6 class="title font-weight-bold" style="margin-bottom: 0.2rem;">{{ study_type }}</h6>
        {% endif %}

        {% if entry.institution %}
          <h6 style="font-size: 0.95rem; margin-bottom: 0.15rem;">{{ entry.institution }}</h6>
        {% endif %}

        {% if entry.area %}
          <p style="font-size: 0.85rem; font-style: italic; color: #888; margin-bottom: 0.5rem;">{{ entry.area }}{% if entry.score %} · {{ entry.score }}{% endif %}</p>
        {% endif %}

        {% if entry.courses or entry.highlights %}
          <ul class="items" style="margin-bottom: 0;">
            {% for item in entry.courses %}
              <li><span class="item">{{ item }}</span></li>
            {% endfor %}
            {% for item in entry.highlights %}
              <li><span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
