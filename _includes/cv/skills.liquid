{% comment %}
  Rich categorized skills renderer
{% endcomment %}

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
  }
  .skill-category h4 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0.02em;
    color: #555;
    margin-bottom: 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #eee;
  }
  .skill-category ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .skill-category li {
    padding: 0.15rem 0;
    font-size: 0.9rem;
    color: #555;
  }
</style>

<div class="skills-grid">
  {% for entry in entries %}
    <div class="skill-category">
      <h4>{{ entry.name }}</h4>
      {% if entry.keywords %}
        <ul>
          {% for keyword in entry.keywords %}
            <li>{{ keyword }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
